# ─────────────────────────────────────────────────────────────────────────────
# SchoolAI — Variables de entorno
# Copia este archivo a .env y completa los valores
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://schoolai:CAMBIA_ESTO@localhost:5432/schoolai

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=          # Token del bot principal (Modo Libre) — @BotFather
TELEGRAM_BOT_TOKEN_JORNADA=  # Token del bot Modo Jornada — opcional
TELEGRAM_BOT_TOKEN_AGENTE=   # Token del bot Agente IA (legacy v1) — opcional
TELEGRAM_ALLOWED_USERS=      # IDs separados por coma: 123456789,987654321
ADMIN_TELEGRAM_ID=           # ID del admin que recibe alertas de error — opcional

# ── LLM stack v2 (formato: "provider/model") ──────────────────────────────────
# Fuente de verdad: src/schoolai/config.py — benchmark: docs/llm-benchmark.md

# CLASSIFIER — gateway/router.py: clasifica intent en JSON (domain, intent, entities)
LLM_ROUTER=mistral/mistral-medium-latest
LLM_ROUTER_FALLBACK=deepseek/deepseek-reasoner

# PLANNER — agent/planner.py: genera plan JSON [{tool, params}]
LLM_PLANNER=groq/openai/gpt-oss-120b
LLM_PLANNER_FALLBACK=ollama/gemini-3-flash-preview:cloud,deepseek/deepseek-reasoner

# SYNTHESIZER — agent/synthesizer.py: redacta respuesta final en español
LLM_SYNTHESIZER=groq/meta-llama/llama-4-scout-17b-16e-instruct
LLM_SYNTHESIZER_FALLBACK=ollama/gemini-3-flash-preview:cloud,mistral/mistral-small-latest

# CHAT — skills/ia/skill.py: chat libre con búsqueda web nativa
LLM_CHAT=groq/compound-beta
LLM_CHAT_FALLBACK=mistral/mistral-small-latest

# EXTRACTOR — skills v1: extracción estructurada de asistencia/tareas
LLM_EXTRACTOR=mistral/mistral-medium-latest

# VISION — análisis de imágenes (fotos, documentos)
LLM_VISION=openrouter/nvidia/nemotron-nano-12b-v2-vl:free
LLM_VISION_FALLBACK=openrouter/google/gemma-4-31b-it:free

# CONTEXT AGENT — skills/orchestrator/skill_agents/context.py
LLM_CONTEXT_AGENT=mistral/mistral-small-latest

# ── API Keys ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=           # Planner + Synthesizer + Whisper — https://console.groq.com
MISTRAL_API_KEY=        # Classifier + Extractor + fallbacks — https://console.mistral.ai
DEEPSEEK_API_KEY=       # Fallback planner/classifier — https://platform.deepseek.com
OPENROUTER_API_KEY=     # Vision models — https://openrouter.ai
ZAI_API_KEY=            # Z.AI (GLM) — https://bigmodel.cn
GOOGLE_API_KEY=         # Google AI Studio — https://aistudio.google.com
NVIDIA_API_KEY=         # NVIDIA NIM — https://build.nvidia.com
MINIMAX_API_KEY=        # MiniMax — https://platform.minimaxi.com
MOONSHOT_API_KEY=       # Moonshot AI — https://platform.moonshot.cn
ZHIPU_API_KEY=          # ZhipuAI — https://open.bigmodel.cn
KILO_API_KEY=           # Kilo AI Gateway — https://kilo.ai
HF_TOKEN=               # HuggingFace Inference Providers — https://huggingface.co/settings/tokens
OPENAI_API_KEY=         # OpenAI — https://platform.openai.com
OLLAMA_API_KEY=ollama   # Ollama local — valor fijo, no cambiar

# ── API REST / JWT ────────────────────────────────────────────────────────────
# Generar JWT_SECRET_KEY con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=          # OBLIGATORIO en producción — clave para firmar tokens
API_SECRET=              # Clave compartida que el cliente PWA usa en POST /auth/token
JWT_EXPIRE_HOURS=24      # Tiempo de vida del JWT en horas

# ── Gateway v2 ────────────────────────────────────────────────────────────────
GATEWAY_ENABLED=false    # true → bot Telegram usa pipeline v2 (Gateway + Agent Runtime)
GATEWAY_URL=http://localhost:8001  # usado por CLI y canales externos

# ── WhatsApp (opcional) ───────────────────────────────────────────────────────
GREEN_API_INSTANCE=      # idInstance de Green API — https://green-api.com
GREEN_API_TOKEN=         # apiTokenInstance de Green API

# ── Redis (opcional) ──────────────────────────────────────────────────────────
# Sin REDIS_URL el estado de sesión vive solo en RAM (se pierde al reiniciar el bot)
# Con Redis la sesión Jornada sobrevive reinicios durante el día escolar
REDIS_URL=               # Ejemplo: redis://localhost:6379/0

# ── Institución ───────────────────────────────────────────────────────────────
SCHOOL_TIMEZONE=America/Guayaquil  # Zona horaria IANA
SUPERVISED_MODE=false    # true → el bot pide confirmación antes de escribir en DB

# ── FastAPI ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# ── Logs ─────────────────────────────────────────────────────────────────────
LOG_DIR=logs
