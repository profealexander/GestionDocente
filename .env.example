# ─────────────────────────────────────────────────────────────────────────────
# SchoolAI — Variables de entorno
# Copia este archivo a .env y completa los valores
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://schoolai:CAMBIA_ESTO@localhost:5432/schoolai

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=       # Token del bot principal (Modo Libre) — @BotFather
TELEGRAM_BOT_TOKEN_JORNADA=  # Token del bot Modo Jornada — opcional
TELEGRAM_BOT_TOKEN_AGENTE=   # Token del bot Agente IA (GLM tool calling) — opcional
TELEGRAM_ALLOWED_USERS=   # IDs separados por coma: 123456789,987654321
ADMIN_TELEGRAM_ID=        # ID del admin que recibe alertas de error — opcional

# ── LLM (formato: "provider/model") ──────────────────────────────────────────
LLM_EXTRACTOR=google/gemini-2.5-flash-lite          # Extracción estructurada (JSON/schema)
LLM_CHAT=mistral/mistral-large-latest                # Chat IA general
LLM_ROUTER=google/gemini-2.5-flash-lite              # Clasificación / routing
LLM_ORCHESTRATOR=mistral/mistral-small-latest        # Orquestador multi-tool
LLM_ORCHESTRATOR_FALLBACK=google/gemini-2.5-flash-lite,mistral/mistral-large-latest,groq/llama-3.3-70b-versatile

# ── API Keys ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=             # Groq — Whisper transcripción + fallback LLM — https://console.groq.com
GOOGLE_API_KEY=           # Google AI Studio — Gemini — https://aistudio.google.com
MISTRAL_API_KEY=          # Mistral — chat + orquestación — https://console.mistral.ai

# ── API REST / JWT ────────────────────────────────────────────────────────────
# Generar JWT_SECRET_KEY con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=           # OBLIGATORIO en producción — clave para firmar tokens
API_SECRET=               # Clave compartida que el cliente PWA usa en POST /auth/token
JWT_EXPIRE_HOURS=24       # Tiempo de vida del JWT en horas

# ── WhatsApp (opcional) ───────────────────────────────────────────────────────
GREEN_API_INSTANCE=       # idInstance de Green API — https://green-api.com
GREEN_API_TOKEN=          # apiTokenInstance de Green API

# ── Redis (opcional) ──────────────────────────────────────────────────────────
# Sin REDIS_URL el estado de sesión vive solo en RAM (se pierde al reiniciar el bot)
# Con Redis la sesión Jornada sobrevive reinicios durante el día escolar
REDIS_URL=                # Ejemplo: redis://localhost:6379/0

# ── FastAPI ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# ── Logs ─────────────────────────────────────────────────────────────────────
LOG_DIR=logs
